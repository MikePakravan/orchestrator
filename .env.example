# Backend
APP_ENV=dev
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
TASK_HISTORY_PATH=./data/tasks.json
USE_MOCK_AGENTS=true

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Provider API keys - replace locally or configure in Azure Key Vault/App Service settings.
GEMINI_API_KEY=placeholder-gemini-api-key
OPENAI_API_KEY=placeholder-openai-api-key
ANTHROPIC_API_KEY=placeholder-anthropic-api-key

# Azure deployment parameters - do not commit tenant or subscription values.
AZURE_LOCATION=australiaeast
AZURE_ENVIRONMENT=dev
AZURE_RESOURCE_PREFIX=orchestrator-dev

